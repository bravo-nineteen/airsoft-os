#!/bin/sh
# AOS desktop session. Keep Openbox as a recoverable window manager.
export GTK_THEME=Adwaita:dark
export QT_STYLE_OVERRIDE=Fusion
export XDG_CURRENT_DESKTOP=AOS
python3 /opt/aos/linux/configure-openbox.py
python3 /opt/aos/linux/configure-window-theme.py
openbox --config-file "$HOME/.config/aoj-os/openbox-rc.xml" &
WM_PID=$!
if command -v xfce4-power-manager >/dev/null 2>&1; then xfce4-power-manager >/dev/null 2>&1 & fi
if command -v nm-applet >/dev/null 2>&1; then nm-applet >/dev/null 2>&1 & fi
if command -v thunar >/dev/null 2>&1; then
    thunar --daemon >/dev/null 2>&1 &
    if command -v thunar-volman >/dev/null 2>&1; then thunar-volman --daemon >/dev/null 2>&1 & fi
fi
# Restart the AOS shell on crashes; a normal exit returns to the login screen.
while kill -0 "$WM_PID" 2>/dev/null; do
    /opt/aos/linux/start-aos.sh
    CODE=$?
    [ "$CODE" -eq 0 ] && break
    sleep 2
done
kill "$WM_PID" 2>/dev/null || true
wait "$WM_PID" 2>/dev/null || true
